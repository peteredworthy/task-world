OPENAI_API_KEY=sk-your-key-here
# OPENHANDS_URL=http://localhost:3000

# Authentication (disabled by default for local development)
AUTH_DISABLED=true
# JWT_SECRET=  # Auto-generated if empty when auth is enabled

# Optional durable JSONL event journal override. Rotates at journal.max_bytes
# (64 MiB by default; minimum 1 MiB) in ~/.orchestrator/config.yaml.
# ORCHESTRATOR_EVENT_JOURNAL_PATH=.orchestrator/state/history.jsonl
