{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-item.schema.json",
  "title": "Grounded UI foundation semantic item",
  "type": "object",
  "required": [
    "id",
    "title",
    "definition",
    "implementation_status",
    "test_status",
    "documentation_status",
    "confidence",
    "confidence_basis",
    "evidence_ids",
    "conflict_ids",
    "question_ids",
    "limitations",
    "prohibited_interpretations"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "implementation_status": {
      "enum": ["present", "absent", "partial", "unknown"]
    },
    "test_status": {
      "enum": ["exercised", "unexercised", "contradicted", "unknown"]
    },
    "documentation_status": {
      "enum": ["documented", "undocumented", "stale", "conflicting", "unknown"]
    },
    "capability_status": {
      "enum": ["current", "derived", "proposed", "gap", "unknown"]
    },
    "epistemic_status": {
      "enum": [
        "observed",
        "deterministically-derived",
        "inferred",
        "operator-asserted",
        "proposed",
        "unknown"
      ]
    },
    "confidence": {"type": ["number", "string"]},
    "confidence_basis": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "conflict_ids": {"type": "array", "items": {"type": "string"}},
    "question_ids": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "prohibited_interpretations": {"type": "array", "items": {"type": "string"}},
    "freshness": {"type": ["object", "string", "null"]}
  },
  "additionalProperties": true
}
